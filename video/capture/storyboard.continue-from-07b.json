        {
          "zoomTarget": {
            "selector": "section.tk-charter",
            "as": "ledger"
          }
        },
        {
          "pause": 1500
        },
        {
          "zoomTarget": {
            "selector": "section[aria-label='Payout receipt']",
            "as": "receipt"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Judge mode story']",
            "as": "story-bar"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Agent trace']",
            "as": "agent-trace"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Payout receipt']",
            "as": "receipt"
          }
        },
        {
          "snapshot": {
            "selector": "section.tk-charter",
            "as": "charter-ledger"

    {
      "id": "cap-13-round4",
      "tailMs": 600,
      "steps": [
        {
          "click": {
            "role": "button",
            "name": "Next: Clean Round 4 (no clicks)"
          },
          "label": "story:Clean Round 4 (no clicks)"
        },
        {
          "waitForText": "Story complete",
          "timeout": 600000
        },
        {
          "zoomTarget": {
            "selector": "section[aria-label='Rotation board']",
            "as": "board-r4"
          }
        },
        {
          "pause": 1500
        },
        {
          "zoomTarget": {
            "selector": "section[aria-label='Counters']",
            "as": "counters"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Judge mode story']",
            "as": "story-bar"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Agent trace']",
            "as": "agent-trace"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Payout receipt']",
            "as": "receipt"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Counters']",
            "as": "counters"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Rotation board']",
            "as": "board"

# Copy to .env and fill in. Never commit .env.
# All PayPal credentials must come from a SANDBOX app linked to a US sandbox Business account.

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after scripts/register_webhook.py runs (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=
# Public base URL of this deployment (Render URL or an ngrok tunnel for local webhooks)
PUBLIC_BASE_URL=http://localhost:8000

# --- AI model (optional; the app runs fully without any key) ---------------------------------------------
# No key at all: the treasurer runs in RULES mode (deterministic) and replays any recorded AI runs from the
# llm_cache table. The default AI is a FREE provider through the OpenAI SDK:
#   groq   : free key at console.groq.com (no card). Default model openai/gpt-oss-120b (~30 req/min, ~1K/day).
#            Drop to openai/gpt-oss-20b with TK_LLM_MODEL if you hit limits. Best for the hosted demo.
#   gemini : free key at aistudio.google.com (India supported). Default model gemini-3.8-flash (~20 req/day,
#            best quality, keep it for the video takes); gemini-3.5-flash-lite (~500/day) for dry runs.
#            Free-tier prompts may be used for training: only synthetic demo data reaches the model.
#   openai_compat : any OpenAI-compatible server (Ollama http://localhost:11434/v1, OpenRouter, Cerebras...);
#            needs TK_LLM_BASE_URL and TK_LLM_MODEL.
#   anthropic : optional paid switch; uses ANTHROPIC_API_KEY (or TK_LLM_API_KEY) and TK_REASONING_MODEL.
#   none   : AI off (rules mode only, no replay).
# Leave TK_LLM_PROVIDER empty to infer it from the key (gsk_... -> groq, AIza... -> gemini).
TK_LLM_PROVIDER=
TK_LLM_API_KEY=
# Optional overrides (defaults per provider above)
TK_LLM_MODEL=
TK_LLM_BASE_URL=
# 0 = default (4096 for free providers, 8000 for Anthropic). Free tiers meter tokens per minute.
TK_LLM_MAX_TOKENS=0
# Optional: low|medium|high, sent as reasoning_effort to OpenAI-compatible providers that support it.
TK_LLM_REASONING_EFFORT=
# Replay cache: auto (replay a recorded turn when present, else call live and record) | record | replay | off
TK_LLM_CACHE=auto
# Live AI runs allowed per visitor IP per hour (routes enforce it; -1 = unlimited, 0 = replay/rules only)
TK_LIVE_LLM_PER_IP_HOUR=10

# Anthropic (optional paid switch; demo workspace key with a spend limit)
ANTHROPIC_API_KEY=
TK_REASONING_MODEL=claude-opus-5-5
TK_TEXT_MODEL=claude-haiku-5-5

# Server secrets (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
MANDATE_HMAC_SECRET=
MCP_DEMO_TOKEN=
SESSION_SECRET=

# Storage
TK_DB_PATH=./data/turnkeeper.db

# Safety switches
TURNKEEPER_FREEZE=0
TK_PAYPAL_RATE_PER_MIN=40

# Demo seed (builder B): real sandbox vault ids for the 6 fixture members, captured once with
# scripts/smoke/a_setup_token.py. Without it every charge is NOT_VAULTED and /healthz reports
# "members not vaulted". One line of JSON, either {handle: vault_id} or per-member objects:
# TK_SEED_VAULT_IDS={"asha":"<vault id>","ravi":"<vault id>","meena":"<vault id>","tomas":"<vault id>","lin":"<vault id>","dev":"<vault id>"}
# TK_SEED_VAULT_IDS={"asha":{"vault_id":"<vault id>","customer_id":"<customer id>","payout_receiver":"<sandbox personal email>","payout_wallet":"PAYPAL"}}
TK_SEED_VAULT_IDS=

{
  "baseUrl": "http://localhost:8030",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 1,
  "fps": 30,
  "typeDelay": 40,
  "hoverMs": 450,
  "actionTitles": false,
  "scenes": [
    {
      "id": "cap-07b-decline-detail",
      "tailMs": 600,
      "steps": [
        {
          "waitForSelector": "section[aria-label='Rotation board'] .b-sch-event",
          "timeout": 20000
        },
        {
          "click": {
            "selector": "section[aria-label='Rotation board'] .b-sch-event:has-text('Declined')"
          },
          "label": "ravi-declined"
        },
        {
          "waitForText": "sandbox-injected",
          "timeout": 10000
        },
        {
          "zoomTarget": {
            "selector": ".tk-selected",
            "as": "decline-detail"
          }
        },
        {
          "pause": 2500
        },
        {
          "click": {
            "role": "button",
            "name": "close"
          },
          "label": "close-detail"
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Judge mode story']",
            "as": "story-bar"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Agent trace']",
            "as": "agent-trace"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Rotation board']",
            "as": "board"
          }
        }
      ],
      "setup": [
        {
          "goto": "/"
        }
      ]
    },
    {
      "id": "cap-08-reply",
      "tailMs": 600,
      "steps": [
        {
          "click": {
            "role": "button",
            "name": "Next: Reply as Ravi (Hindi)"
          },
          "label": "story:Reply as Ravi (Hindi)"
        },
        {
          "waitForText": "Next: Start recovery",
          "timeout": 30000
        },
        {
          "zoomTarget": {
            "selector": ".tk-phone-card",
            "as": "ravi-reply"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Judge mode story']",
            "as": "story-bar"
          }
        },
        {
          "snapshot": {
            "selector": ".tk-phone-card",
            "as": "phone"
          }
        },
        {
          "pause": 3500
        }
      ]
    },
    {
      "id": "cap-09-recovery",
      "tailMs": 600,
      "steps": [
        {
          "click": {
            "role": "button",
            "name": "Next: Start recovery"
          },
          "label": "story:Start recovery"
        },
        {
          "waitForText": "Next: Consent as the affected members",
          "timeout": 480000
        },
        {
          "zoomTarget": {
            "selector": "section[aria-label='Recovery']",
            "as": "remedies"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Judge mode story']",
            "as": "story-bar"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Agent trace']",
            "as": "agent-trace"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Recovery']",
            "as": "recovery"
          }
        },
        {
          "pause": 3500
        }
      ]
    },
    {
      "id": "cap-10-approve",
      "tailMs": 600,
      "steps": [
        {
          "click": {
            "role": "button",
            "name": "Next: Consent as the affected members"
          },
          "label": "story:Consent as the affected members"
        },
        {
          "waitForText": "Next: Vote as members (quorum)",
          "timeout": 30000
        },
        {
          "zoomTarget": {
            "selector": ".tk-vote",
            "as": "consents"
          }
        },
        {
          "click": {
            "role": "button",
            "name": "Next: Vote as members (quorum)"
          },
          "label": "story:Vote as members (quorum)"
        },
        {
          "waitForText": "Next: Approve as Priya (one tap)",

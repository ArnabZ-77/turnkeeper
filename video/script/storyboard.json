{
  "version": 1,
  "title": "Turnkeeper demo video",
  "fps": 30,
  "output": {
    "width": 1920,
    "height": 1080
  },
  "audio": {
    "dir": "audio/vo",
    "durations": "audio/vo/durations.json",
    "script": "script/voiceover.json",
    "english_voice": "kokoro af_heart (speed 0.92; lines C01, P01, P02 0.94-1.0; L23 0.88)",
    "hindi_voice": "edge-tts hi-IN-MadhurNeural",
    "music": null,
    "music_note": "No music. If added later: royalty-free only, ducked under the voice."
  },
  "capture": {
    "baseUrl": "http://localhost:8000",
    "runs": {
      "desktop": {
        "viewport": {
          "width": 1920,
          "height": 1080
        },
        "scenes_in_order": [
          "cap-00-reset",
          "cap-04-compile",
          "cap-06-forecast",
          "cap-07-round3",
          "cap-08-reply",
          "cap-09-recovery",
          "cap-10-approve",
          "cap-11-execute",
          "cap-12-payout",
          "cap-13-round4"
        ]
      },
      "phone": {
        "viewport": {
          "width": 390,
          "height": 844
        },
        "scenes_in_order": [
          "cap-05-join"
        ],
        "note": "Separate capture run (capture.ts has one viewport per storyboard), so a separate browser context and session. Composite inside a phone frame at about 0.95 of frame height."
      }
    },
    "setup_scene": {
      "id": "cap-00-reset",
      "used_in_edit": false,
      "steps": [
        {
          "goto": "/"
        },
        {
          "waitForText": "Next: Reset demo",
          "timeout": 30000
        },
        {
          "click": {
            "role": "button",
            "name": "Next: Reset demo"
          },
          "label": "story:reset"
        },
        {
          "waitForText": "Next: Advance to T-3 (forecast)",
          "timeout": 30000
        }
      ]
    },
    "preconditions": [
      "Server started with TK_LLM_PROVIDER=none (rules mode; no model call; matches the recorded live run).",
      "PAYPAL_ENV=sandbox with credentials and TK_SEED_VAULT_IDS set; /healthz shows paypal_configured true, vault_seeded true, no warnings.",
      "US sandbox Business account topped up with at least about $2,400 USD before the take (each full story pays out 2 x $1,154.93; docs/live-run/2026-10-25-rerun.md R1).",
      "The StoryBar chip must read 'PayPal sandbox live'. If it reads 'PayPal steps simulated', stop: the narration's live claims would be false.",
      "Light theme (the capture context uses colorScheme light). Advanced controls drawer closed; never use it mid-story (a run that used it is never served as the replay).",
      "The desktop run keeps one page across scenes, so the story state carries from scene to scene; scenes must run in order."
    ]
  },

            "as": "invoice-qr"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Judge mode story']",
            "as": "story-bar"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Agent trace']",
            "as": "agent-trace"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Recovery']",
            "as": "recovery"
          }
        },
        {
          "pause": 2500
        }
      ]
    },
    {
      "id": "cap-12-payout",
      "tailMs": 600,
      "steps": [
        {
          "click": {
            "role": "button",
            "name": "Next: Pay Round 3"
          },
          "label": "story:Pay Round 3"
        },
        {
          "waitForText": "Next: Clean Round 4 (no clicks)",
          "timeout": 360000

# Copy to .env and fill in. Never commit .env.
# All PayPal credentials must come from a SANDBOX app linked to a US sandbox Business account.

PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after scripts/register_webhook.py runs (needed to verify webhook signatures)
PAYPAL_WEBHOOK_ID=
# Public base URL of this deployment (Render URL or an ngrok tunnel for local webhooks)
PUBLIC_BASE_URL=http://localhost:8000

# Anthropic (demo workspace key with a spend limit)
ANTHROPIC_API_KEY=
TK_REASONING_MODEL=claude-opus-5-5
TK_TEXT_MODEL=claude-haiku-5-5

# Server secrets (generate: python -c "import secrets;print(secrets.token_urlsafe(32))")
MANDATE_HMAC_SECRET=
MCP_DEMO_TOKEN=
SESSION_SECRET=

# Storage
TK_DB_PATH=./data/turnkeeper.db

# Safety switches
TURNKEEPER_FREEZE=0
TK_PAYPAL_RATE_PER_MIN=40

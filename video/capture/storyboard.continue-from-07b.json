        {
          "zoomTarget": {
            "selector": ".tk-approved-chip",
            "as": "approved"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Judge mode story']",
            "as": "story-bar"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Recovery']",
            "as": "recovery"
          }
        },
        {
          "pause": 1200
        }
      ]
    },
    {
      "id": "cap-11-execute",
      "tailMs": 600,
      "steps": [
        {
          "click": {
            "role": "button",
            "name": "Next: Execute remedies"
          },
          "label": "story:Execute remedies"

{
  "baseUrl": "http://localhost:8030",
  "viewport": {
    "width": 1920,
    "height": 1080
  },
  "deviceScaleFactor": 1,
  "fps": 30,
  "typeDelay": 40,
  "hoverMs": 450,
  "actionTitles": false,
  "scenes": [
    {
      "id": "cap-00-reset",
      "tailMs": 600,
      "steps": [
        {
          "goto": "/"
        },
        {
          "waitForText": "Next: Reset demo",
          "timeout": 30000
        },
        {
          "click": {
            "role": "button",
            "name": "Next: Reset demo"
          },
          "label": "story:reset"
        },
        {
          "waitForText": "Next: Advance to T-3 (forecast)",
          "timeout": 30000
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Judge mode story']",
            "as": "story-bar"
          }
        }
      ]
    },
    {
      "id": "cap-04-compile",
      "tailMs": 600,
      "steps": [
        {
          "goto": "/compile"
        },
        {
          "waitForText": "Compile charter",
          "timeout": 20000
        },
        {
          "zoomTarget": {
            "label": "Rules text",
            "as": "rules-hi"
          }
        },
        {
          "pause": 1500
        },
        {
          "click": {
            "role": "button",
            "name": "Compile charter"
          },
          "label": "compile"
        },
        {
          "waitForText": "same as the demo circle",
          "timeout": 30000
        },
        {
          "zoomTarget": {
            "selector": "section[aria-label='Compiled charter']",
            "as": "charter-card"
          }
        },
        {
          "pause": 1800
        },
        {
          "click": {
            "role": "button",
            "name": "Freeze charter"
          },
          "label": "freeze"
        },
        {
          "waitForText": "Billing plan PayPal shows each member",
          "timeout": 30000
        },
        {
          "zoomTarget": {
            "selector": "section[aria-label='Frozen charter'] .tk-chip-hash",
            "as": "hash"
          }
        },
        {
          "zoomTarget": {
            "selector": "section[aria-label='Frozen charter'] .tk-fee-line",
            "as": "fees"
          }
        },
        {
          "pause": 1500
        },
        {
          "click": {
            "role": "button",
            "name": "Approve as Priya (organizer)"
          },
          "label": "approve-charter"
        },
        {
          "waitForText": "Member invites (signed, expiring)",
          "timeout": 30000
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Compiled charter']",
            "as": "compiled-charter"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Frozen charter']",
            "as": "frozen-charter"
          }
        },
        {
          "pause": 1000
        }
      ]
    },
    {
      "id": "cap-06-forecast",
      "tailMs": 600,
      "steps": [
        {
          "goto": "/"
        },
        {
          "waitForText": "Next: Advance to T-3 (forecast)",
          "timeout": 30000
        },
        {
          "pause": 800
        },
        {
          "click": {
            "role": "button",
            "name": "Next: Advance to T-3 (forecast)"
          },
          "label": "story:Advance to T-3 (forecast)"
        },
        {
          "waitForText": "Next: Run Round 3 (Ravi declines)",
          "timeout": 120000
        },
        {
          "waitForSelector": ".tk-forecast-row",
          "timeout": 10000
        },
        {
          "zoomTarget": {
            "selector": "section[aria-label='Shortfall forecast']",
            "as": "forecast"
          }
        },
        {
          "pause": 2500
        },
        {
          "zoomTarget": {
            "selector": ".tk-phone-card",
            "as": "nudge-hi"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Judge mode story']",
            "as": "story-bar"
          }
        },
        {
          "snapshot": {
            "selector": "section[aria-label='Shortfall forecast']",
            "as": "forecast"
          }
        },
        {
          "snapshot": {
            "selector": ".tk-phone-card",
            "as": "nudge"
          }
        },
        {
          "pause": 2000
        }
      ]
